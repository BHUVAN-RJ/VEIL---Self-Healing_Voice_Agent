# yc-voice-agent-hackathon - Environment Variables
# Copy this file to .env and fill in your API keys

# Twilio (Transport) — required for phone calls + auto-hangup via end_call tool
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Public ngrok hostname (no https://) for Twilio media streams webhook
TWILIO_PROXY=

# STT: "deepgram" (default, multi-language Hinglish) or "nvidia" (hackathon Nemotron ASR)
STT_PROVIDER=deepgram

# Deepgram (STT)
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3-general
DEEPGRAM_LANGUAGE=multi

# Cartesia (TTS — Arushi voice, Language.HI for Hinglish output)
CARTESIA_API_KEY=
CARTESIA_VOICE_ID=95d51f79-c397-46f9-b49a-23763d3eaa2d
CARTESIA_MODEL=sonic-3

# NVIDIA Nemotron ASR (STT) — only used when STT_PROVIDER=nvidia
NVIDIA_ASR_URL=ws://44.241.251.184:8080

# NVIDIA Nemotron LLM (conversation + post-call classification)
NEMOTRON_LLM_URL=http://nemotron-fleet-alb-1322439314.us-west-2.elb.amazonaws.com/v1
NEMOTRON_LLM_MODEL=nvidia/nemotron-3-super
NEMOTRON_LLM_API_KEY=EMPTY
NEMOTRON_ENABLE_THINKING=false

# Set to "local" to disable Krisp noise filter during local dev
ENV=local

# Optional: Claude fallback for classification (not used by default)
# ANTHROPIC_API_KEY=
